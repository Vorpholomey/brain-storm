generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum SessionMode {
  QUICK
  TEAM
  ASYNC
  PERSONAL
}

enum SessionStage {
  DISCUSSION
  VOTING_ROUND_1
  REFINEMENT
  FINAL_VOTE
  COMPLETED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum IdeaStatus {
  DRAFT
  DISCUSSION
  FINALIST
  SELECTED
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  createdAt      DateTime       @default(now())
  organizedSessions Session[]   @relation("OrganizedSessions")
  sessionMembers SessionMember[]
  authoredIdeas  Idea[]         @relation("IdeaAuthor")
  selectedIdeas  Idea[]         @relation("IdeaSelector")
  votes          Vote[]
  comments       Comment[]
}

model Session {
  id              String          @id @default(cuid())
  organizerId     String
  organizer       User            @relation("OrganizedSessions", fields: [organizerId], references: [id])
  topic           String
  mode            SessionMode
  config          Json
  currentStage    SessionStage    @default(DISCUSSION)
  stageDeadline   DateTime?
  selectedIdeaId  String?         @unique
  selectedIdea    Idea?           @relation("SelectedIdea", fields: [selectedIdeaId], references: [id])
  status          SessionStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  ideas           Idea[]
  members         SessionMember[]

  @@index([organizerId])
  @@index([status])
}

model Idea {
  id                String      @id @default(cuid())
  sessionId         String
  session           Session     @relation(fields: [sessionId], references: [id])
  authorId          String
  author            User        @relation("IdeaAuthor", fields: [authorId], references: [id])
  title             String
  content           String
  status            IdeaStatus  @default(DRAFT)
  selectedAt        DateTime?
  selectedById      String?
  selectedBy        User?       @relation("IdeaSelector", fields: [selectedById], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  votes             Vote[]
  comments          Comment[]
  isSelected        Boolean     @default(false) @map("is_selected")
  selectedBySession Session?    @relation("SelectedIdea")

  @@index([sessionId])
  @@index([authorId])
  @@index([selectedById])
}

enum MemberRole {
  ORGANIZER
  PARTICIPANT
}

model SessionMember {
  id        String     @id @default(cuid())
  sessionId String
  session   Session    @relation(fields: [sessionId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  role      MemberRole @default(PARTICIPANT)
  joinedAt  DateTime   @default(now())

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Vote {
  id        String   @id @default(cuid())
  sessionId String
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([sessionId, userId, ideaId])
  @@index([sessionId, userId])
  @@index([ideaId])
}

model Comment {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  createdAt DateTime @default(now())
}
