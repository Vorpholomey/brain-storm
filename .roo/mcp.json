{
	"mcpServers": {
		"playwright": {
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@0.0.38"
			],
			"alwaysAllow": [
				"browser_take_screenshot",
				"browser_navigate",
				"browser_console_messages",
				"browser_wait_for",
				"browser_close",
				"browser_fill_form",
				"browser_click",
				"browser_snapshot",
				"browser_network_requests"
			]
		},
		"context7": {
			"type": "streamable-http",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"Authorization": "Bearer ctx7sk-06d6f0df-e1e8-4400-a105-14ca7707a4af"
			},
			"alwaysAllow": [
				"resolve-library-id",
				"query-docs"
			]
		},
		"shadcn-react": {
			"command": "npx",
			"args": [
				"shadcn@latest",
				"mcp"
			]
		},
		"shadcn-vue": {
			"command": "npx",
			"args": [
				"shadcn-vue@latest",
				"mcp"
			]
		}
	}
}