# ===========================================
# .gitignore для Brain Storm
# ===========================================

# -------------------
# 1. Общие правила
# -------------------

# macOS
.DS_Store

# Логи
*.log

# Зависимости
node_modules/

# Скомпилированные файлы
dist/
build/

# Переменные окружения
.env
# Но сохраняем пример
!.env.example

# -------------------
# 2. IDE / Редакторы
# -------------------

# VS Code (сохраняем настройки и задачи)
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
.roo

# JetBrains IDEs
.idea/

# Vim/Neovim
*.swp
*.swo
*~

# -------------------
# 3. TypeScript
# -------------------

# Сгенерированные JavaScript и d.ts файлы
# (в корневом уровне и в папках, где TS компилируется на месте)
*.js
*.d.ts

# Исключения для конфигурационных файлов JavaScript
!vite.config.js
!vite.config.cjs
!tailwind.config.js
!postcss.config.js

# -------------------
# 4. Prisma
# -------------------

# Сгенерированные Prisma клиент/типы
server/prisma/generated/

# -------------------
# 5. Тестирование
# -------------------

# Coverage отчёты
coverage/
.nyc_output/

# -------------------
# 6.Tmp/Кэш
# -------------------

# Vite кэш
.vite/

# TypeScript кэш
tsconfig.tsbuildinfo

# -------------------
# 7. Запуск приложения
# -------------------

# pm2 логи
.pm2/

# -------------------
# Примечание:
# package-lock.json — СОХРАНЯЕТСЯ (не игнорируется)
# Это важно для воспроизводимости зависимостей
# -------------------
